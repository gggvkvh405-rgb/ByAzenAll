{
  "name": "byazen-desktop-suite",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Dark desktop library with 185 ByAzen app prototypes.",
  "author": "ByAzen",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win portable zip --x64 --publish never",
    "desktop:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide": "^1.79.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.byazen.desktop",
    "productName": "ByAzen",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "ui",
        "filter": ["index.html", "favicon.svg", "assets/**"]
      },
      {
        "from": "public/ByAzen.ico",
        "to": "ByAzen.ico"
      }
    ],
    "win": {
      "artifactName": "ByAzen-${version}-windows-${arch}.${ext}",
      "icon": "public/ByAzen.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ByAzen-${version}-portable.${ext}"
    }
  }
}
